# ============================================================
# Кэширование: при обновлении сайта/логотипа клиенты видят новое
# ============================================================
# Работает на Apache. Для nginx — настройте аналогично в конфиге.
# ============================================================

<IfModule mod_headers.c>
    # HTML: не кэшировать. Браузер всегда запрашивает свежую страницу.
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Логотип и фавикон: не кэшировать агрессивно.
    # При смене файла + ?v= в HTML пользователи сразу увидят новое.
    <FilesMatch "^(logo\.png|favicon\.ico)$">
        Header set Cache-Control "max-age=0, no-cache, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Все картинки в assets/ — короткий кэш, чтобы при смене ?v= в HTML
    # (в т.ч. из Telegram на телефоне) подтягивалась новая версия.
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|ico)$">
        Header set Cache-Control "max-age=0, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# Ниже — опционально. Раскомментируйте, если хостинг поддерживает mod_expires
# и вы хотите жёстко ограничить кэш для всех статики в assets.
# <IfModule mod_expires.c>
#     ExpiresActive On
#     ExpiresByType image/png "access plus 0 seconds"
#     ExpiresByType image/x-icon "access plus 0 seconds"
# </IfModule>
